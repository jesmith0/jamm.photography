---
// A single overlay for the whole page. The reel's frames carry their data in
// data-* attributes; this dialog reads them on open. Native <dialog> gives us
// focus-trapping, Esc-to-close and background inert for free.
---

<dialog id="lightbox" class="lightbox" aria-label="Photograph viewer" tabindex="-1">
  <div class="lightbox__loader" data-lb-loader aria-hidden="true"></div>
  <div class="lightbox__controlbar" aria-hidden="true"></div>
  <button class="lightbox__close" data-lb-close type="button" aria-label="Close (Esc)">✕</button>
  <button class="lightbox__nav lightbox__nav--prev" data-lb-prev type="button" aria-label="Previous exposure">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M15 5 L8 12 L15 19"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
  <button class="lightbox__nav lightbox__nav--next" data-lb-next type="button" aria-label="Next exposure">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M9 5 L16 12 L9 19"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <div class="lightbox__inner">
    <figure class="lightbox__figure">
      <img class="lightbox__img" data-lb-img alt="" />
    </figure>
    <div class="lightbox__meta">
      <p class="lightbox__rollexp" data-lb-rollexp></p>
      <h2 class="lightbox__title" data-lb-title></h2>
      <p class="lightbox__place" data-lb-place></p>
      <dl class="lightbox__specs" data-lb-specs></dl>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dialog) {
    const triggers = Array.from(document.querySelectorAll<HTMLElement>('.frame[data-full]'));
    const img = dialog.querySelector('[data-lb-img]') as HTMLImageElement;
    const elTitle = dialog.querySelector('[data-lb-title]') as HTMLElement;
    const elPlace = dialog.querySelector('[data-lb-place]') as HTMLElement;
    const elRollExp = dialog.querySelector('[data-lb-rollexp]') as HTMLElement;
    const elSpecs = dialog.querySelector('[data-lb-specs]') as HTMLElement;
    const prevBtn = dialog.querySelector('[data-lb-prev]') as HTMLButtonElement;
    const nextBtn = dialog.querySelector('[data-lb-next]') as HTMLButtonElement;
    const closeBtn = dialog.querySelector('[data-lb-close]') as HTMLButtonElement;
    const swipeArea = dialog.querySelector('.lightbox__inner') as HTMLElement;

    // Location is shown under the title, so it's not repeated here.
    const SPECS: [string, string][] = [
      ['camera', 'Camera'],
      ['lens', 'Lens'],
      ['aperture', 'Aperture'],
      ['shutter', 'Shutter'],
      ['iso', 'ISO'],
      ['date', 'Date'],
    ];

    let current = -1;
    let lastFocus: HTMLElement | null = null;

    const rollOf = (i: number) => triggers[i]?.dataset.roll;

    // ---- loading ------------------------------------------------------
    // The full-size frame is fetched off to the side and only swapped in once
    // it has decoded, so the <img> never blanks out mid-navigation (an empty
    // <img> collapses to nothing and the whole frame jumps, which is most of
    // what reads as "lag"). Until it lands the outgoing photo is dimmed right
    // back and a hairline sweeps the top edge.
    const loaderDelayMs = 120;
    const prefetched = new Set<string>();
    let loadToken = 0;
    let loaderTimer: number | undefined;

    function setLoading(on: boolean) {
      window.clearTimeout(loaderTimer);
      if (!on) {
        dialog!.classList.remove('is-loading');
        return;
      }
      // hold off briefly: a cached frame swaps instantly and shouldn't flash
      loaderTimer = window.setTimeout(
        () => dialog!.classList.add('is-loading'),
        loaderDelayMs,
      );
    }

    /** Warm the neighbouring frames so sequential swiping has nothing to wait for. */
    function prefetchNeighbours(i: number) {
      if ((navigator as any).connection?.saveData) return;
      for (const delta of [1, -1]) {
        const j = i + delta;
        if (j < 0 || j >= triggers.length || rollOf(j) !== rollOf(i)) continue;
        const url = triggers[j].dataset.full;
        if (!url || prefetched.has(url)) continue;
        prefetched.add(url);
        new Image().src = url;
      }
    }

    function showPhoto(url: string, alt: string, i: number) {
      const token = ++loadToken;
      let settled = false;
      setLoading(true);

      const commit = () => {
        // a later swipe already superseded this frame — drop it
        if (settled || token !== loadToken) return;
        settled = true;
        img.src = url;
        img.alt = alt;
        setLoading(false);
        prefetchNeighbours(i);
      };

      const pre = new Image();
      pre.addEventListener(
        'load',
        () => {
          // decode before swapping so the paint itself can't stutter
          if (typeof pre.decode === 'function') pre.decode().then(commit, commit);
          else commit();
        },
        { once: true },
      );
      // a broken frame still needs to hand over to the <img>, which shows
      // its own alt text rather than leaving the loader spinning forever
      pre.addEventListener('error', commit, { once: true });
      pre.src = url;
      if (pre.complete) commit(); // already cached: 'load' may never fire
    }

    function render(i: number) {
      const d = triggers[i].dataset;
      showPhoto(d.full || '', d.alt || d.title || '', i);
      elRollExp.textContent = `Roll ${d.roll} — Exp ${d.frame}`;
      elTitle.textContent = d.title || '';
      elPlace.textContent = d.location || '';
      elSpecs.replaceChildren();
      for (const [key, label] of SPECS) {
        const val = d[key];
        if (!val) continue;
        const row = document.createElement('div');
        const dt = document.createElement('dt');
        dt.textContent = label;
        const dd = document.createElement('dd');
        dd.textContent = val;
        row.append(dt, dd);
        elSpecs.append(row);
      }
      current = i;
      prevBtn.disabled = !(i > 0 && rollOf(i - 1) === rollOf(i));
      nextBtn.disabled = !(i < triggers.length - 1 && rollOf(i + 1) === rollOf(i));
      history.replaceState(null, '', `#r${d.roll}f${d.frame}`);
    }

    function open(i: number) {
      lastFocus = document.activeElement as HTMLElement;
      render(i);
      if (!dialog!.open) dialog!.showModal();
      // focus the dialog itself, not whichever control the browser would
      // otherwise auto-focus — so arrow-key navigation never lands on / lights
      // up a button the visitor didn't actually mean to interact with
      dialog!.focus();
    }

    function step(delta: number) {
      const j = current + delta;
      if (j < 0 || j >= triggers.length || rollOf(j) !== rollOf(current)) return;
      render(j);
    }

    triggers.forEach((t, i) =>
      t.addEventListener('click', (ev) => {
        // let cmd/ctrl/shift/middle-click open the raw image in a new tab
        if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.button !== 0) return;
        ev.preventDefault();
        open(i);
      }),
    );
    closeBtn.addEventListener('click', () => dialog.close());
    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));

    // Swipe left/right to step through the roll.
    //
    // Touch events rather than pointer events, and deliberately non-passive:
    // preventDefault() on the first horizontal move is the only thing that
    // stops the browser claiming the drag as a native scroll and killing it
    // with a pointercancel long before it reaches the distance threshold.
    // Passive listeners silently ignore preventDefault, hence the explicit
    // { passive: false }.
    const SWIPE_THRESHOLD = 45; // px of travel that commits to a step
    const AXIS_LOCK = 10; // px before we decide horizontal vs vertical

    let touchId: number | null = null;
    let startX = 0;
    let startY = 0;
    let deltaX = 0;
    let axis: 'x' | 'y' | null = null;
    let lastSwipeAt = 0;

    const activeTouch = (list: TouchList) =>
      Array.from(list).find((t) => t.identifier === touchId);

    function clearDrag() {
      touchId = null;
      axis = null;
      deltaX = 0;
      img.style.transition = '';
      img.style.transform = '';
    }

    // the whole overlay is the swipe surface, not just the photo's own pixels
    // — .lightbox__figure is display:contents and so has no box of its own,
    // and a portrait frame leaves wide dead margins either side of the image
    swipeArea.addEventListener(
      'touchstart',
      (ev) => {
        if (ev.touches.length !== 1) {
          clearDrag(); // a second finger means pinch-zoom, not a swipe
          return;
        }
        const t = ev.changedTouches[0];
        touchId = t.identifier;
        startX = t.clientX;
        startY = t.clientY;
        deltaX = 0;
        axis = null;
      },
      { passive: true },
    );

    swipeArea.addEventListener(
      'touchmove',
      (ev) => {
        if (touchId === null) return;
        const t = activeTouch(ev.touches);
        if (!t) return;

        deltaX = t.clientX - startX;
        const dy = t.clientY - startY;

        if (axis === null) {
          // wait for enough travel to tell a swipe from a scroll
          if (Math.abs(deltaX) < AXIS_LOCK && Math.abs(dy) < AXIS_LOCK) return;
          axis = Math.abs(deltaX) > Math.abs(dy) ? 'x' : 'y';
        }
        // vertical gesture: leave it alone so the metadata scrolls natively
        if (axis !== 'x') return;

        if (ev.cancelable) ev.preventDefault();
        img.style.transition = 'none';
        img.style.transform = `translateX(${deltaX}px)`;
      },
      { passive: false },
    );

    function endTouch() {
      if (touchId === null) return;
      const committed = axis === 'x' && Math.abs(deltaX) > SWIPE_THRESHOLD;
      const direction = deltaX < 0 ? 1 : -1;
      clearDrag();
      if (committed) {
        lastSwipeAt = Date.now();
        step(direction);
      }
    }
    swipeArea.addEventListener('touchend', endTouch);
    swipeArea.addEventListener('touchcancel', endTouch);

    // click the dark area outside the content to close
    dialog.addEventListener('click', (ev) => {
      // a swipe ending over the backdrop synthesises a click — don't let it
      // close the overlay the visitor was only navigating through
      if (Date.now() - lastSwipeAt < 500) return;
      if (ev.target === dialog || ev.target === img.closest('.lightbox__inner')) dialog.close();
    });
    dialog.addEventListener('keydown', (ev) => {
      if (ev.key !== 'ArrowLeft' && ev.key !== 'ArrowRight') return;
      // move focus off whatever button happens to hold it first, so the
      // roll-navigation shortcut never reveals a focus ring on a control
      // the visitor didn't mean to interact with
      dialog.focus();
      step(ev.key === 'ArrowLeft' ? -1 : 1);
    });
    dialog.addEventListener('close', () => {
      history.replaceState(null, '', location.pathname + location.search);
      // invalidate any frame still in flight so it can't land after closing
      loadToken++;
      setLoading(false);
      img.removeAttribute('src');
      lastFocus?.focus?.();
    });

    // deep link: /#r012f07
    const m = location.hash.match(/^#r(.+)f(-?\d+)$/);
    if (m) {
      const idx = triggers.findIndex(
        (t) => t.dataset.roll === m[1] && Number(t.dataset.frame) === Number(m[2]),
      );
      if (idx >= 0) open(idx);
    }
  }
</script>
