---
const path = Astro.url.pathname;
const isIndex = path === '/';
const links = [
  { href: '/', label: 'Index' },
  { href: '/about', label: 'About' },
];

// The brand link is the page's <h1> only on the homepage.
const Brand = isIndex ? 'h1' : 'p';
---

<header class="masthead">
  <div class="shell masthead__row">
    <Brand class="brand">
      <a href="/">jamm.photography</a>
    </Brand>
    <nav class="nav mono" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.href === path ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
