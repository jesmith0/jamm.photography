---
import { Image, getImage } from 'astro:assets';
import { pad2, type Exposure } from '../lib/rolls';

interface Props {
  exposure: Exposure;
  roll: string;
}
const { exposure: e, roll } = Astro.props;

// Full-size optimised source for the modal — loaded on demand by the lightbox,
// and used as the link target so clicking still works with JavaScript off.
const full = await getImage({ src: e.image, width: 1600, format: 'webp' });

const dateLabel = e.date
  ? e.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
  : '';
---

<a
  class="frame"
  href={full.src}
  data-full={full.src}
  data-alt={e.alt}
  data-title={e.title}
  data-roll={roll}
  data-frame={pad2(e.frame)}
  data-location={e.location}
  data-date={dateLabel}
  data-camera={e.camera ?? ''}
  data-lens={e.lens ?? ''}
  data-aperture={e.aperture ?? ''}
  data-shutter={e.shutter ?? ''}
  data-iso={e.iso ?? ''}
  aria-label={`Roll ${roll}, exposure ${pad2(e.frame)} — ${e.title}. Open full size.`}
>
  <span class="frame__media">
    <Image src={e.image} alt={e.alt} height={480} loading="lazy" />
  </span>
  <span class="frame__no">{pad2(e.frame)}</span>
</a>
