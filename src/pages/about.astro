---
import Base from '../layouts/Base.astro';
import { getRolls } from '../lib/rolls';

const rolls = await getRolls();
const frames = rolls.reduce((n, r) => n + r.data.exposures.length, 0);
---

<Base title="About" compact>
  <section class="about">
    <h1>On waiting for weather</h1>
    <p>
      Jamm photographs quiet places — coastlines at the turn of the tide, fog that
      arrives without warning, fields that go on longer than they should. The work is
      less about the subject than the light that happens to be passing through it.
    </p>
    <p>
      Each roll is shown whole, in the order it was shot, frame by frame. Nothing is
      rescued in the edit. If an exposure needed saving, it didn't make the reel.
    </p>

    <dl class="colophon">
      <div>
        <dt>Rolls</dt>
        <dd>{rolls.length} archived</dd>
      </div>
      <div>
        <dt>Exposures</dt>
        <dd>{frames} frames</dd>
      </div>
      <div>
        <dt>Set in</dt>
        <dd>Space Grotesk &amp; Space Mono</dd>
      </div>
      <div>
        <dt>Built with</dt>
        <dd><a href="https://astro.build">Astro</a></dd>
      </div>
      <div>
        <dt>Contact</dt>
        <dd><a href="mailto:hello@jamm.photography">hello@jamm.photography</a></dd>
      </div>
    </dl>
  </section>
</Base>
