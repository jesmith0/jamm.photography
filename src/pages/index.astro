---
import Base from '../layouts/Base.astro';
import Roll from '../components/Roll.astro';
import Lightbox from '../components/Lightbox.astro';
import { getRolls } from '../lib/rolls';

const rolls = await getRolls();
---

<Base>
  <div class="reel">
    {rolls.map((roll) => <Roll roll={roll} />)}
  </div>
  <Lightbox />
</Base>
